# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ScholarPilot API integration
# Set to "false" to connect to real backend via ngrok tunnel (default in .env.local)
# Set to "true" to use standalone mock mode fallback
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_BASE_URL=https://underfeed-caterer-backlands.ngrok-free.dev
VITE_USE_MOCK=false
VITE_API_BASE_URL=https://underfeed-caterer-backlands.ngrok-free.dev

