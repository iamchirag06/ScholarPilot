# ScholarPilot AI/ML Engine Environment Variables

# Qdrant Vector Database
# Supports both standard names and project aliases (QDART_ENDPOINT, QDRAT_API_KEY)
QDRANT_ENDPOINT=https://your-cluster-id.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
# Set to ":memory:" for zero-cost offline in-memory Qdrant (ideal for isolated testing)
# QDRANT_LOCATION=:memory:

# Relational Database (PostgreSQL or local SQLite for tests)
# Format: postgresql+psycopg2://user:password@localhost:5432/scholarpilot
# Defaults to sqlite:///./scholarpilot.db if unset
DATABASE_URL=sqlite:///./scholarpilot.db

# Optional LLM Providers (Google Gemini & Groq Free Tier)
# Leave blank to use 100% free deterministic template engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model Configuration
# Uses local FastEmbed on CPU (zero API cost, ONNX Runtime)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_COLLECTION_NAME=scholarships_v1

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
